# PLY header and element tokens (multi-byte, from pcl::PLYReader/ply_parser)
"ply"
"format ascii 1.0"
"format binary_little_endian 1.0"
"format binary_big_endian 1.0"
"comment"
"element vertex"
"element face"
"element camera"
"element range_grid"
"element material"
"property float x"
"property float y"
"property float z"
"property float nx"
"property uchar red"
"property uchar green"
"property uchar blue"
"property float red"
"property float s"
"property float t"
"property list uchar int vertex_indices"
"property list uchar int vertex_index"
"property list uchar float texcoord"
"property list uchar uchar vertex_indices"
"property list int int vertex_indices"
"property double x"
"property char x"
"property short x"
"end_header"
