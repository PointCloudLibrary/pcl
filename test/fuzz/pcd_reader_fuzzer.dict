# PCD header and body keywords (multi-byte tokens from pcl::PCDReader::readHeader)
"# .PCD v0.7 - Point Cloud Data file format"
"VERSION 0.7"
"VERSION 0.6"
"FIELDS x y z"
"FIELDS x y z rgb"
"FIELDS x y z normal_x normal_y normal_z curvature"
"FIELDS x y z intensity"
"SIZE 4 4 4"
"SIZE 4 4 4 4"
"SIZE 1 1 1"
"SIZE 2 2 2"
"SIZE 8 8 8"
"TYPE F"
"TYPE F F F"
"TYPE U"
"TYPE I"
"TYPE F F F U"
"COUNT 1"
"COUNT 1 1 1"
"COUNT 2 2 2"
"WIDTH 1"
"WIDTH 4"
"HEIGHT 1"
"HEIGHT 4"
"VIEWPOINT 0 0 0 1 0 0 0"
"POINTS 8"
"DATA ascii"
"DATA binary"
"DATA binary_compressed"
"nan"
